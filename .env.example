# =====================================================================
# Delta Exchange MCP & Multi-Agent Trading Team Configuration
# =====================================================================

# Environment selection:
# Options:
#   - "india"   -> Live Delta Exchange India (https://api.india.delta.exchange)
#   - "global"  -> Live Delta Exchange Global (https://api.delta.exchange)
#   - "testnet" -> Delta Exchange Testnet (https://cdn-ind.testnet.deltaex.org or https://testnet-api.delta.exchange)
DELTA_ENVIRONMENT=india

# Delta Exchange API Credentials
# Create these at:
#   India:  https://india.delta.exchange/app/settings/api-keys
#   Global: https://www.delta.exchange/app/settings/api-keys
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Custom Base URL (Optional: leave empty to use default based on DELTA_ENVIRONMENT)
# DELTA_BASE_URL=https://api.india.delta.exchange

# ---------------------------------------------------------------------
# Risk Management & Circuit Breaker Controls
# ---------------------------------------------------------------------
# Maximum percentage of account balance to risk on any single trade (e.g., 0.02 = 2%)
MAX_RISK_PER_TRADE_PCT=0.02

# Absolute hard dollar cap on any single trade loss
MAX_DOLLAR_RISK_PER_TRADE=25.00

# Maximum open positions allowed simultaneously
MAX_CONCURRENT_POSITIONS=3

# Maximum daily account drawdown before trading halts (e.g., 0.05 = 5%)
MAX_DAILY_DRAWDOWN_PCT=0.05

# Maximum leverage permitted by Risk Gatekeeper (e.g., 5 = 5x leverage)
MAX_ALLOWED_LEVERAGE=10

# Minimum Reward-to-Risk ratio required for trade approval (e.g., 2.0 = 2:1)
MIN_REWARD_TO_RISK_RATIO=2.0

# ---------------------------------------------------------------------
# Multi-Agent Execution Settings
# ---------------------------------------------------------------------
# Default trading symbols to monitor (comma-separated)
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT

# Trading Mode:
#   "interactive" -> Asks user for confirmation before placing orders [Recommended for start]
#   "autonomous"  -> Automatically executes trades that pass all agent gates
TRADING_MODE=interactive

# Scan Interval in seconds for autonomous loop (e.g., 300 = 5 minutes)
SCAN_INTERVAL_SECONDS=300
